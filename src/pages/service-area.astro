---
import BaseLayout from '@/layouts/BaseLayout.astro';

const counties = [
  'Alameda',
  'Contra Costa',
  'Marin',
  'Napa',
  'San Francisco',
  'San Mateo',
  'Santa Clara',
  'Sonoma',
];
---

<BaseLayout
  title="Our Service Area"
  description="Engage As You Age provides in-home senior social visits throughout the San Francisco Bay Area, including 8 Northern California counties."
>
  <main>
    <!-- Hero -->
    <section class="relative isolate flex min-h-[28rem] items-center overflow-hidden lg:min-h-[34rem]">
      <img
        src="/images/senior-caregiver-hands.jpg"
        alt="A caregiver gently holding the hands of a senior"
        class="absolute inset-0 -z-10 h-full w-full object-cover object-center"
        loading="eager"
        fetchpriority="high"
        width={1400}
        height={931}
      />
      <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/35 via-black/15 to-transparent"></div>
      <div class="mx-auto w-full max-w-content px-4 py-20 text-center sm:px-6">
        <div class="mx-auto max-w-2xl rounded-3xl bg-white/85 p-8 backdrop-blur-sm sm:p-12">
          <h1 class="text-5xl font-bold tracking-tight text-gray-900 text-balance">
            Our Service Area
          </h1>
          <p class="mx-auto mt-6 max-w-2xl text-xl text-pretty text-gray-700">
            Services designed to meet your needs, where you need them.
          </p>
        </div>
      </div>
    </section>

    <!-- Body -->
    <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
      <h2 class="text-3xl font-semibold text-gray-900 dark:text-white">
        Experience and Expertise at Your Service
      </h2>
      <p class="mt-6 text-lg text-gray-600 dark:text-gray-400">
        Founded in 2009 in San Francisco, Engage As You Age has expanded to serve the Greater Bay Area.
        We encourage you to contact us to learn how our social visits can enhance quality of life for
        seniors and their families.
      </p>

      <img
        src="/images/seniors-hands-community.jpg"
        alt="Close-up of seniors' hands joined together in community"
        class="mt-10 rounded-2xl w-full object-cover shadow-sm"
        style="aspect-ratio: 16/6"
        loading="lazy"
        width={1200}
        height={450}
      />

      <h3 class="mt-10 text-xl font-semibold text-gray-900 dark:text-white">Counties We Serve</h3>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2 list-none p-0 m-0">
        {counties.map((county) => (
          <li class="flex items-center gap-2 text-gray-700 dark:text-gray-300">
            <span class="text-brand-600 dark:text-brand-400" aria-hidden="true">&#10003;</span>
            {county} County
          </li>
        ))}
      </ul>

      <div class="mt-10 rounded-xl border border-gray-200 bg-gray-50 p-6 dark:border-gray-700 dark:bg-gray-800">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Hours of Operation</h3>
        <dl class="mt-3 space-y-1 text-gray-600 dark:text-gray-400">
          <div class="flex gap-4">
            <dt class="w-36 font-medium text-gray-700 dark:text-gray-300">Monday &ndash; Friday</dt>
            <dd>8:00 am &ndash; 8:00 pm</dd>
          </div>
          <div class="flex gap-4">
            <dt class="w-36 font-medium text-gray-700 dark:text-gray-300">Saturday &ndash; Sunday</dt>
            <dd>8:00 am &ndash; 5:00 pm</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-brand-600 dark:bg-brand-800">
      <div class="mx-auto max-w-content px-4 py-16 sm:px-6 text-center">
        <h2 class="text-3xl font-bold text-white text-balance">Serving Your Area?</h2>
        <p class="mx-auto mt-4 max-w-xl text-lg text-green-100">
          Contact us to confirm coverage in your neighborhood and schedule a free consultation.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a
            href="/contact"
            class="inline-flex items-center rounded-full bg-white px-8 py-3 text-base font-semibold text-brand-700 shadow hover:bg-brand-50 transition-colors"
          >
            Contact Us
          </a>
          <a
            href="tel:4156906944"
            class="inline-flex items-center rounded-full border-2 border-white px-8 py-3 text-base font-semibold text-white hover:bg-brand-700 transition-colors"
          >
            Call 415-690-6944
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
