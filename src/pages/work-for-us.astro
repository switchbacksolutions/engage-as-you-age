---
import BaseLayout from '@/layouts/BaseLayout.astro';

const steps = [
  'Initial phone interview',
  'In-person interview to assess interests and situational responses',
  'Reference check',
  'Professional criminal and background check',
  'Paid training before client placement',
];
---

<BaseLayout
  title="Work For Us"
  description="Join Engage As You Age as an Activity Specialist in the Greater Bay Area. The most meaningful part-time job you'll ever have."
>
  <main>
    <!-- Hero -->
    <section class="relative isolate flex min-h-[28rem] items-center overflow-hidden lg:min-h-[34rem]">
      <img
        src="/images/senior-woman-flowers.jpg"
        alt="A senior woman delighting in fresh flowers"
        class="absolute inset-0 -z-10 h-full w-full object-cover object-center"
        loading="eager"
        fetchpriority="high"
        width={1200}
        height={800}
      />
      <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/35 via-black/15 to-transparent"></div>
      <div class="mx-auto w-full max-w-content px-4 py-20 text-center sm:px-6">
        <div class="mx-auto max-w-2xl rounded-3xl bg-white/85 p-8 backdrop-blur-sm sm:p-12">
          <h1 class="text-5xl font-bold tracking-tight text-gray-900 text-balance">
            Work For Us
          </h1>
          <p class="mx-auto mt-6 max-w-2xl text-xl text-pretty text-gray-700">
            The most meaningful part-time job you'll ever have.
          </p>
        </div>
      </div>
    </section>

    <!-- About the role -->
    <section class="mx-auto max-w-content px-4 py-16 sm:px-6">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div class="prose-content">
          <p>
            We're seeking Activity Specialists across the Greater Bay Area for part-time positions. We
            welcome individuals with expertise and passion for lifelong learning — yoga instructors,
            artists, historians, and anyone with specialized knowledge or a love of conversation.
          </p>
          <p>
            Prior experience working with seniors is not required. We're looking for candidates with
            enthusiasm, intelligence, patience, and curiosity. If that sounds like you, we'd love to
            hear from you.
          </p>

          <h2>Our Screening Process</h2>
          <ol>
            {steps.map((step) => <li>{step}</li>)}
          </ol>

          <h2>What Our Employees Say</h2>
          <blockquote>
            <p>
              "Engage As You Age is the most caring and conscientious employer I've ever worked for.
              They are genuinely interested in employee success."
            </p>
            <footer>&mdash; Amie, South San Francisco</footer>
          </blockquote>
        </div>
        <div class="lg:sticky lg:top-8">
          <img
            src="/images/senior-yoga.jpg"
            alt="A younger and senior woman practicing yoga together in a wellness center"
            class="rounded-2xl w-full object-cover shadow-lg"
            style="aspect-ratio: 3/4"
            loading="lazy"
            width={800}
            height={1067}
          />
        </div>
      </div>
    </section>

    <!-- Application form -->
    <section class="bg-gray-50 dark:bg-gray-900">
      <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
        <h2 class="text-3xl font-semibold text-gray-900 dark:text-white">Apply Now</h2>
        <p class="mt-4 text-gray-600 dark:text-gray-400">
          Fill out the form below and we'll be in touch. You can also call us at{' '}
          <a href="tel:4156906944" class="font-medium">415-690-6944</a>.
        </p>

        <form
          name="work-for-us"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="mt-8 space-y-6"
        >
          <p class="hidden">
            <label>Don't fill this out: <input name="bot-field" /></label>
          </p>

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="name" class="block text-base font-medium text-gray-700 dark:text-gray-300">
                Full Name
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                class="mt-1 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 placeholder-gray-400 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-gray-600 dark:bg-gray-800 dark:text-white dark:placeholder-gray-500 dark:focus:border-brand-400 dark:focus:ring-brand-400"
                placeholder="Jane Smith"
              />
            </div>
            <div>
              <label for="email" class="block text-base font-medium text-gray-700 dark:text-gray-300">
                Email
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                class="mt-1 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 placeholder-gray-400 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-gray-600 dark:bg-gray-800 dark:text-white dark:placeholder-gray-500 dark:focus:border-brand-400 dark:focus:ring-brand-400"
                placeholder="jane@example.com"
              />
            </div>
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="phone" class="block text-base font-medium text-gray-700 dark:text-gray-300">
                Phone
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                autocomplete="tel"
                class="mt-1 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 placeholder-gray-400 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-gray-600 dark:bg-gray-800 dark:text-white dark:placeholder-gray-500 dark:focus:border-brand-400 dark:focus:ring-brand-400"
                placeholder="(415) 555-0100"
              />
            </div>
            <div>
              <label for="start-date" class="block text-base font-medium text-gray-700 dark:text-gray-300">
                Available Start Date
              </label>
              <input
                type="date"
                id="start-date"
                name="start-date"
                required
                class="mt-1 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-gray-600 dark:bg-gray-800 dark:text-white dark:focus:border-brand-400 dark:focus:ring-brand-400"
              />
            </div>
          </div>

          <div>
            <label for="linkedin" class="block text-base font-medium text-gray-700 dark:text-gray-300">
              LinkedIn or CV URL
            </label>
            <input
              type="url"
              id="linkedin"
              name="linkedin"
              class="mt-1 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 placeholder-gray-400 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-gray-600 dark:bg-gray-800 dark:text-white dark:placeholder-gray-500 dark:focus:border-brand-400 dark:focus:ring-brand-400"
              placeholder="https://linkedin.com/in/your-profile"
            />
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="hours" class="block text-base font-medium text-gray-700 dark:text-gray-300">
                Desired hours per week
              </label>
              <input
                type="text"
                id="hours"
                name="hours"
                class="mt-1 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 placeholder-gray-400 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-gray-600 dark:bg-gray-800 dark:text-white dark:placeholder-gray-500 dark:focus:border-brand-400 dark:focus:ring-brand-400"
                placeholder="e.g. 10–15 hours"
              />
            </div>
            <div>
              <label for="pay" class="block text-base font-medium text-gray-700 dark:text-gray-300">
                Hourly pay expectations
              </label>
              <input
                type="text"
                id="pay"
                name="pay"
                class="mt-1 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 placeholder-gray-400 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-gray-600 dark:bg-gray-800 dark:text-white dark:placeholder-gray-500 dark:focus:border-brand-400 dark:focus:ring-brand-400"
                placeholder="e.g. $22–$28/hr"
              />
            </div>
          </div>

          <div>
            <label for="skills" class="block text-base font-medium text-gray-700 dark:text-gray-300">
              Special skills and interests
            </label>
            <input
              type="text"
              id="skills"
              name="skills"
              class="mt-1 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 placeholder-gray-400 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-gray-600 dark:bg-gray-800 dark:text-white dark:placeholder-gray-500 dark:focus:border-brand-400 dark:focus:ring-brand-400"
              placeholder="e.g. yoga, art history, bridge, memoir writing"
            />
          </div>

          <div>
            <label for="motivation" class="block text-base font-medium text-gray-700 dark:text-gray-300">
              Why do you want to work with seniors?
            </label>
            <textarea
              id="motivation"
              name="motivation"
              required
              rows="5"
              class="mt-1 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 placeholder-gray-400 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-gray-600 dark:bg-gray-800 dark:text-white dark:placeholder-gray-500 dark:focus:border-brand-400 dark:focus:ring-brand-400"
              placeholder="Tell us what draws you to this work…"
            ></textarea>
          </div>

          <div>
            <button
              type="submit"
              class="btn-primary"
            >
              Submit Application
            </button>
          </div>
        </form>
      </div>
    </section>
  </main>
</BaseLayout>
