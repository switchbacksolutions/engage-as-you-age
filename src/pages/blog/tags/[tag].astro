---
/**
 * src/pages/blog/tags/[tag].astro — Tag archive page
 *
 * Statically generated for every tag used by a published post; lists posts
 * carrying that tag, newest first. Linked from the tag pills on /blog and
 * on each post. The route param is a URL-safe slug (e.g. "family-caregivers")
 * derived from the human-readable tag label (e.g. "Family Caregivers"), which
 * is what gets displayed.
 */

import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogPostListItem from '@/components/BlogPostListItem.astro';
import { slugify } from '@/lib/slugify';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  const labelsBySlug = new Map<string, string>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      labelsBySlug.set(slugify(tag), tag);
    }
  }

  return [...labelsBySlug.entries()].map(([slug, label]) => ({
    params: { tag: slug },
    props: {
      label,
      posts: posts
        .filter((post) => post.data.tags.some((tag) => slugify(tag) === slug))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { label, posts } = Astro.props;
---

<BaseLayout
  title={`Posts tagged "${label}"`}
  description={`Browse all blog posts tagged "${label}".`}
>
  <main class="mx-auto max-w-content px-4 py-12 sm:px-6">
    <header class="mb-10">
      <a
        href="/blog"
        class="text-base font-medium text-brand-600 no-underline hover:underline dark:text-brand-400"
      >
        &larr; All posts
      </a>
      <h1 class="mt-3 text-4xl font-bold text-gray-900 dark:text-white">
        Tagged: <span class="tag-pill align-middle">{label}</span>
      </h1>
      <p class="mt-3 text-lg text-gray-600 dark:text-gray-400">
        {posts.length} post{posts.length !== 1 ? 's' : ''}
      </p>
    </header>

    <ul class="divide-y divide-gray-200 dark:divide-gray-700 list-none m-0 p-0" data-testid="blog-post-list">
      {posts.map((post) => <BlogPostListItem post={post} />)}
    </ul>
  </main>
</BaseLayout>
