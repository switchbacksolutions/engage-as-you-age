---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import FormattedDate from '@/components/FormattedDate.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Engage As You Age"
  description="Engage As You Age fosters social connections for San Francisco Bay Area older adults and people living with dementia or other impairments."
>
  <main>

    <!-- ─── Hero ──────────────────────────────────────────────────────── -->
    <section class="relative isolate flex min-h-[36rem] items-center overflow-hidden lg:min-h-[44rem]">
      <img
        src="/images/seniors-laughing-conversation.jpg"
        alt="A senior woman laughing warmly while talking with friends over drinks"
        class="absolute inset-0 -z-10 h-full w-full -scale-x-100 object-cover object-center"
        loading="eager"
        fetchpriority="high"
        width={2200}
        height={1466}
      />
      <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/80 via-black/40 to-black/10"></div>
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/60 via-black/10 to-transparent"></div>

      <div class="mx-auto w-full max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
        <div class="max-w-2xl rounded-3xl bg-black/70 p-8 backdrop-blur-sm sm:p-12">
          <p class="text-base font-semibold uppercase tracking-widest text-brand-100 mb-5">
            San Francisco Bay Area
          </p>
          <h1 class="text-5xl lg:text-6xl font-bold tracking-tight text-white text-balance" style="line-height: 1.1">
            The social specialists<br class="hidden sm:block" /> for seniors.
          </h1>
          <p class="mt-6 text-xl text-gray-100 text-pretty leading-relaxed">
            We pair older adults — including those living with dementia or Alzheimer's — with empathetic specialists who share their passions. Less isolation, more joy.
          </p>
          <div class="mt-10 flex flex-wrap gap-4">
            <a href="/contact" class="btn-primary">Schedule a consultation</a>
            <a
              href="/services"
              class="inline-flex items-center justify-center rounded-full border-2 border-white/80 px-6 py-3 text-base font-semibold text-white backdrop-blur-sm transition-colors hover:bg-white/10"
            >
              Learn how it works
            </a>
          </div>
          <p class="mt-6 text-base text-gray-200">
            Or call us: <a
              href="tel:4156906944"
              class="font-semibold text-white no-underline hover:underline"
            >415-690-6944</a>
          </p>
        </div>
      </div>
    </section>

    <!-- ─── How it works ──────────────────────────────────────────────── -->
    <section class="bg-white dark:bg-gray-950">
      <div class="mx-auto max-w-content px-4 py-20 sm:px-6">
        <h2 class="text-center text-3xl font-bold text-gray-900 dark:text-white mb-16">
          How it works
        </h2>
        <div class="grid sm:grid-cols-3 gap-10">
          {[
            {
              num: '1',
              title: 'Schedule a consultation',
              body: 'Tell us about your loved one — their personality, interests, and care needs. No commitment required.',
            },
            {
              num: '2',
              title: 'We find the right specialist',
              body: 'Ben personally interviews and matches every client with a specialist who shares their passions.',
            },
            {
              num: '3',
              title: 'Connection begins',
              body: 'Visits happen at home, in a care facility, or out on a trip. Two-hour minimum; no travel fees.',
            },
          ].map(({ num, title, body }) => (
            <div>
              <span class="block text-8xl font-bold leading-none text-brand-100 dark:text-brand-900 select-none" aria-hidden="true">
                {num}
              </span>
              <h3 class="mt-3 text-lg font-semibold text-gray-900 dark:text-white">{title}</h3>
              <p class="mt-2 text-gray-600 dark:text-gray-400">{body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── Services ─────────────────────────────────────────────────── -->
    <section class="bg-gray-50 dark:bg-gray-900">
      <div class="mx-auto max-w-content px-4 py-20 sm:px-6">
        <h2 class="text-center text-3xl font-bold text-gray-900 dark:text-white mb-12">
          What we offer
        </h2>
        <div class="grid sm:grid-cols-2 gap-8">
          <a href="/services#one-on-one" class="card group no-underline block">
            <img
              src="/images/senior-swing.jpg"
              alt="Senior enjoying an outing at a park with her activity specialist"
              class="rounded-xl w-full object-cover mb-5"
              style="aspect-ratio: 16/9"
              loading="lazy"
              width={600}
              height={338}
            />
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
              One-on-One Visits
            </h3>
            <p class="mt-2 text-gray-600 dark:text-gray-400">
              Customized visits at home or in a facility — with optional outings to parks, museums, and more.
            </p>
          </a>
          <a href="/services#group-programs" class="card group no-underline block">
            <img
              src="/images/seniors-tea-garden.jpg"
              alt="Senior women laughing together over tea in a garden"
              class="rounded-xl w-full object-cover mb-5"
              style="aspect-ratio: 16/9"
              loading="lazy"
              width={600}
              height={338}
            />
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
              Group Programs
            </h3>
            <p class="mt-2 text-gray-600 dark:text-gray-400">
              Discussion groups and classes at retirement facilities — history, literature, art, and more.
            </p>
          </a>
        </div>
        <p class="mt-10 text-center">
          <a href="/services" class="btn-primary">View all services</a>
        </p>
      </div>
    </section>

    <!-- ─── Testimonials ──────────────────────────────────────────────── -->
    <section class="bg-white dark:bg-gray-950">
      <div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 text-center">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">
          What Our Clients Say
        </h2>
        <svg class="mx-auto mb-8 h-10 w-10 text-brand-200 dark:text-brand-800" fill="currentColor" viewBox="0 0 32 32" aria-hidden="true">
          <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z" />
        </svg>

        <div
          id="testimonial-carousel"
          class="relative"
          role="region"
          aria-roledescription="carousel"
          aria-label="Client testimonials"
        >
          <div class="overflow-hidden">
            <div id="testimonial-track" class="flex transition-transform duration-500 ease-out">
              {[
                {
                  quote: "Engage As You Age has been like finding a diamond in a field of weeds. It's given me such a feeling of relief.",
                  name: 'Carol S.',
                  location: 'San Francisco',
                },
                {
                  quote: 'Engage As You Age has filled a need, a very critical one, that no other organization comes close to addressing. Connection! Mom is happier, keener, healthier and has a more positive outlook on life.',
                  name: 'Laura D.',
                  location: 'Oakland',
                },
                {
                  quote: 'My 87-year-old father has become more engaged with others in his assisted living community. It is wonderful to have someone come and listen to his stories with a fresh ear and perspective.',
                  name: 'Nancy R.',
                  location: 'Palo Alto',
                },
              ].map(({ quote, name, location }, i) => (
                <div class="w-full shrink-0 px-2" role="group" aria-roledescription="slide" aria-label={`${i + 1} of 3`}>
                  <blockquote>
                    <p class="text-2xl font-medium italic text-gray-800 dark:text-gray-200 text-balance leading-relaxed">
                      "{quote}"
                    </p>
                    <footer class="mt-8">
                      <p class="font-semibold text-gray-900 dark:text-white">{name}</p>
                      <p class="text-base text-gray-600 dark:text-gray-300">{location}</p>
                    </footer>
                  </blockquote>
                </div>
              ))}
            </div>
          </div>

          <button
            type="button"
            id="testimonial-prev"
            aria-label="Previous testimonial"
            class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 sm:-translate-x-12 rounded-full p-2 text-gray-400 hover:text-brand-600 hover:bg-brand-50 dark:text-gray-500 dark:hover:text-brand-400 dark:hover:bg-gray-800 transition-colors"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
            </svg>
          </button>
          <button
            type="button"
            id="testimonial-next"
            aria-label="Next testimonial"
            class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 sm:translate-x-12 rounded-full p-2 text-gray-400 hover:text-brand-600 hover:bg-brand-50 dark:text-gray-500 dark:hover:text-brand-400 dark:hover:bg-gray-800 transition-colors"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
          </button>

          <div class="mt-10 flex justify-center gap-2" role="tablist" aria-label="Choose testimonial">
            {[0, 1, 2].map((i) => (
              <button
                type="button"
                class:list={[
                  'testimonial-dot h-2.5 w-2.5 rounded-full transition-colors',
                  i === 0 ? 'bg-brand-600 dark:bg-brand-400' : 'bg-gray-300 dark:bg-gray-700',
                ]}
                role="tab"
                aria-label={`Show testimonial ${i + 1}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                data-index={i}
              />
            ))}
          </div>
        </div>
      </div>
    </section>

    <script>
      const track = document.getElementById('testimonial-track');
      const prevBtn = document.getElementById('testimonial-prev');
      const nextBtn = document.getElementById('testimonial-next');
      const dots = Array.from(document.querySelectorAll('.testimonial-dot'));
      const slideCount = dots.length;
      let current = 0;

      function render() {
        if (!track) return;
        track.style.transform = `translateX(-${current * 100}%)`;
        dots.forEach((dot, i) => {
          const active = i === current;
          dot.classList.toggle('bg-brand-600', active);
          dot.classList.toggle('dark:bg-brand-400', active);
          dot.classList.toggle('bg-gray-300', !active);
          dot.classList.toggle('dark:bg-gray-700', !active);
          dot.setAttribute('aria-selected', active ? 'true' : 'false');
        });
      }

      function go(index: number) {
        current = (index + slideCount) % slideCount;
        render();
      }

      prevBtn?.addEventListener('click', () => go(current - 1));
      nextBtn?.addEventListener('click', () => go(current + 1));
      dots.forEach((dot) => {
        dot.addEventListener('click', () => go(Number(dot.getAttribute('data-index'))));
      });
    </script>

    <!-- ─── Press ─────────────────────────────────────────────────────── -->
    <section class="bg-gray-50 dark:bg-gray-900 border-y border-gray-100 dark:border-gray-800">
      <div class="mx-auto max-w-content px-4 py-12 sm:px-6 text-center">
        <p class="text-base font-semibold uppercase tracking-widest text-gray-600 dark:text-gray-400 mb-8">
          As seen in
        </p>
        <ul class="flex flex-wrap md:flex-nowrap justify-center items-center gap-x-6 gap-y-4 list-none m-0 p-0">
          {[
            { name: 'San Francisco Chronicle', src: '/images/press/sf-chronicle.svg', width: 202, height: 24 },
            { name: 'CBS News Bay Area (KPIX)', src: '/images/press/cbs-5-kpix.svg', width: 101, height: 24 },
            { name: 'Marin Independent Journal', src: '/images/press/marin-ij.svg', width: 246, height: 24 },
            { name: 'J. The Jewish News of Northern California', src: '/images/press/j-jewish-news.jpg', width: 51, height: 24 },
          ].map(({ name, src, width, height }) => (
            <li class="shrink-0">
              <img
                src={src}
                alt={name}
                width={width}
                height={height}
                class="h-6 w-auto object-contain grayscale opacity-50 transition-opacity hover:opacity-90 dark:brightness-0 dark:invert dark:opacity-40 dark:hover:opacity-70"
                loading="lazy"
              />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ─── CTA band ──────────────────────────────────────────────────── -->
    <section class="bg-brand-600 dark:bg-brand-800">
      <div class="mx-auto max-w-content px-4 py-20 sm:px-6 text-center">
        <h2 class="text-3xl font-bold text-white text-balance">
          Give your loved one the gift of connection.
        </h2>
        <p class="mx-auto mt-5 max-w-xl text-lg text-green-100 text-pretty">
          Schedule a consultation today. We'll find the right specialist for your family.
        </p>
        <div class="mt-10 flex flex-wrap justify-center gap-4">
          <a
            href="/contact"
            class="inline-flex items-center rounded-full bg-white px-8 py-3 text-base font-semibold text-brand-700 shadow hover:bg-brand-50 transition-colors"
          >
            Schedule a Consultation
          </a>
          <a
            href="tel:4156906944"
            class="inline-flex items-center rounded-full border-2 border-white px-8 py-3 text-base font-semibold text-white hover:bg-brand-700 transition-colors"
          >
            Call 415-690-6944
          </a>
        </div>
      </div>
    </section>

    <!-- ─── Recent blog posts ─────────────────────────────────────────── -->
    {recentPosts.length > 0 && (
      <section class="bg-white dark:bg-gray-950">
        <div class="mx-auto max-w-content px-4 py-20 sm:px-6">
          <div class="flex items-baseline justify-between mb-10">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
              From the blog
            </h2>
            <a
              href="/blog"
              class="text-base font-medium text-brand-600 no-underline hover:underline dark:text-brand-400"
            >
              View all →
            </a>
          </div>
          <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 list-none m-0 p-0">
            {recentPosts.map((post) => (
              <li>
                <a href={`/blog/${post.id}`} class="group block card h-full no-underline">
                  {post.data.heroImage && (
                    <img
                      src={post.data.heroImage}
                      alt={post.data.title}
                      class="mb-4 h-40 w-full rounded-xl object-cover"
                      loading="lazy"
                      width={600}
                      height={315}
                    />
                  )}
                  {post.data.tags.length > 0 && (
                    <div class="mb-2 flex flex-wrap gap-1">
                      {post.data.tags.slice(0, 2).map((tag) => (
                        <span class="tag-pill">{tag}</span>
                      ))}
                    </div>
                  )}
                  <h3 class="text-lg font-semibold text-gray-900 group-hover:text-brand-600 dark:text-white dark:group-hover:text-brand-400 transition-colors text-balance">
                    {post.data.title}
                  </h3>
                  <p class="mt-2 text-base text-gray-600 dark:text-gray-400 line-clamp-3">
                    {post.data.description}
                  </p>
                  <p class="mt-4 text-base text-gray-600 dark:text-gray-400">
                    <FormattedDate date={post.data.pubDate} format="short" />
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

  </main>
</BaseLayout>
