---
const NAV_LINKS = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  {
    label: 'About',
    href: '/about',
    children: [
      { href: '/why-engage', label: 'Why Engage' },
      { href: '/work-for-us', label: 'Work For Us' },
    ],
  },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];

const pathname = new URL(Astro.request.url).pathname;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}

function isGroupActive(item: (typeof NAV_LINKS)[number]): boolean {
  if (isActive(item.href)) return true;
  return item.children?.some((child) => isActive(child.href)) ?? false;
}

const linkClasses = (active: boolean) =>
  [
    'text-base font-medium no-underline transition-colors',
    active
      ? 'text-brand-600 dark:text-brand-400'
      : 'text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white',
  ].join(' ');
---

<header class="sticky top-0 z-50 border-b border-gray-200 bg-white/90 backdrop-blur dark:border-gray-700 dark:bg-gray-900/90">
  <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4 sm:px-6">
    <a href="/" class="shrink-0 no-underline" aria-label="Engage As You Age — home">
      <img
        src="/engagelogo.png"
        alt="Engage As You Age"
        width="167"
        height="75"
        class="h-[75px] w-auto"
      />
    </a>

    <!-- Desktop navigation -->
    <nav aria-label="Main navigation" class="hidden lg:block">
      <ul class="flex items-center gap-6 list-none m-0 p-0">
        {NAV_LINKS.map((item) => (
          item.children ? (
            <li class="relative">
              <details class="nav-dropdown group">
                <summary
                  class:list={['inline cursor-pointer', linkClasses(isGroupActive(item))]}
                  aria-current={isGroupActive(item) ? 'page' : undefined}
                >
                  {item.label}
                  <svg
                    class="ml-1 inline-block h-6 w-6 align-middle transition-transform group-open:rotate-180"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </summary>
                <ul class="absolute left-0 top-full z-10 mt-2 min-w-[11rem] list-none rounded-lg border border-gray-200 bg-white p-2 m-0 shadow-lg dark:border-gray-700 dark:bg-gray-800">
                  <li>
                    <a href={item.href} class:list={['block rounded-md px-3 py-2', linkClasses(isActive(item.href))]} aria-current={isActive(item.href) ? 'page' : undefined}>
                      Overview
                    </a>
                  </li>
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class:list={['block rounded-md px-3 py-2', linkClasses(isActive(child.href))]}
                        aria-current={isActive(child.href) ? 'page' : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li>
              <a href={item.href} class={linkClasses(isActive(item.href))} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          )
        ))}
        <li>
          <a href="/contact" class="btn-primary text-xs px-4 py-2">
            Schedule a consultation
          </a>
        </li>
      </ul>
    </nav>

    <!-- Mobile navigation -->
    <details class="nav-dropdown relative lg:hidden">
      <summary
        class="flex cursor-pointer items-center justify-center rounded-md p-2 text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
        aria-label="Open main menu"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
        </svg>
      </summary>
      <nav aria-label="Mobile navigation" class="absolute right-0 top-full z-10 mt-2 w-60 rounded-lg border border-gray-200 bg-white p-2 shadow-lg dark:border-gray-700 dark:bg-gray-800">
        <ul class="flex flex-col list-none m-0 p-0">
          {NAV_LINKS.map((item) => (
            item.children ? (
              <li>
                <details class="nav-dropdown group">
                  <summary
                    class:list={[
                      'flex cursor-pointer items-center justify-between gap-1 rounded-md px-3 py-2',
                      linkClasses(isGroupActive(item)),
                    ]}
                    aria-current={isGroupActive(item) ? 'page' : undefined}
                  >
                    {item.label}
                    <svg
                      class="h-6 w-6 transition-transform group-open:rotate-180"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </summary>
                  <ul class="ml-3 list-none border-l border-gray-200 pl-3 m-0 dark:border-gray-700">
                    <li>
                      <a href={item.href} class:list={['block rounded-md px-3 py-2', linkClasses(isActive(item.href))]} aria-current={isActive(item.href) ? 'page' : undefined}>
                        Overview
                      </a>
                    </li>
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class:list={['block rounded-md px-3 py-2', linkClasses(isActive(child.href))]}
                          aria-current={isActive(child.href) ? 'page' : undefined}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a href={item.href} class:list={['block rounded-md px-3 py-2', linkClasses(isActive(item.href))]} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            )
          ))}
          <li class="mt-1">
            <a href="/contact" class="btn-primary block text-center text-xs px-4 py-2">
              Schedule a consultation
            </a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  /* Hide the default <details>/<summary> disclosure triangle so the custom chevron icons stand alone. */
  .nav-dropdown > summary {
    list-style: none;
  }
  .nav-dropdown > summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  // Close open nav dropdowns when a click lands outside them, and when one opens, close its siblings.
  const dropdowns = Array.from(document.querySelectorAll<HTMLDetailsElement>('.nav-dropdown'));

  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    for (const dropdown of dropdowns) {
      if (dropdown.open && !dropdown.contains(target)) {
        dropdown.removeAttribute('open');
      }
    }
  });

  dropdowns.forEach((dropdown) => {
    dropdown.addEventListener('toggle', () => {
      if (!dropdown.open) return;
      for (const other of dropdowns) {
        if (other !== dropdown && other.open && !other.contains(dropdown)) {
          other.removeAttribute('open');
        }
      }
    });
  });
</script>
