---
const NAV_LINKS = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  {
    label: 'About',
    href: '/about',
    children: [
      { href: '/why-engage', label: 'Why Engage' },
      { href: '/work-for-us', label: 'Work For Us' },
    ],
  },
  { href: '/blog', label: 'Blog' },
];

const PHONE_NUMBER = '415-690-6944';
const PHONE_HREF = 'tel:4156906944';
const PHONE_ICON_PATH =
  'M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z';

const pathname = new URL(Astro.request.url).pathname;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}

function isGroupActive(item: (typeof NAV_LINKS)[number]): boolean {
  if (isActive(item.href)) return true;
  return item.children?.some((child) => isActive(child.href)) ?? false;
}

const linkClasses = (active: boolean, size: string = 'text-base') =>
  [
    size,
    'font-medium no-underline transition-colors',
    active
      ? 'text-brand-600 dark:text-brand-400'
      : 'text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white',
  ].join(' ');
---

<header class="sticky top-0 z-50 border-b border-gray-200 bg-white/90 backdrop-blur dark:border-gray-700 dark:bg-gray-900/90">
  <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4 sm:px-6">
    <a href="/" class="shrink-0 no-underline" aria-label="Engage As You Age — home">
      <img
        src="/engagelogo.png"
        alt="Engage As You Age"
        width="167"
        height="75"
        class="h-[75px] w-auto"
      />
    </a>

    <!-- Desktop navigation -->
    <nav aria-label="Main navigation" class="hidden lg:block">
      <ul class="flex items-center gap-6 list-none m-0 p-0">
        {NAV_LINKS.map((item) => (
          item.children ? (
            <li class="relative">
              <details class="nav-dropdown group">
                <summary
                  class:list={['inline-flex items-center cursor-pointer', linkClasses(isGroupActive(item))]}
                  aria-current={isGroupActive(item) ? 'page' : undefined}
                >
                  {item.label}
                  <svg
                    class="ml-1 h-6 w-6 shrink-0 transition-transform group-open:rotate-180"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </summary>
                <ul class="absolute left-0 top-full z-10 mt-2 min-w-[11rem] list-none rounded-lg border border-gray-200 bg-white p-2 m-0 shadow-lg dark:border-gray-700 dark:bg-gray-800">
                  <li>
                    <a href={item.href} class:list={['block rounded-md px-3 py-2', linkClasses(isActive(item.href))]} aria-current={isActive(item.href) ? 'page' : undefined}>
                      Overview
                    </a>
                  </li>
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class:list={['block rounded-md px-3 py-2', linkClasses(isActive(child.href))]}
                        aria-current={isActive(child.href) ? 'page' : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li>
              <a href={item.href} class={linkClasses(isActive(item.href))} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          )
        ))}
        <li>
          <a href="/contact" class="btn-primary text-base px-4 py-2">
            Contact
          </a>
        </li>
        <li>
          <a
            href={PHONE_HREF}
            class="inline-flex items-center gap-1.5 text-base font-medium text-gray-600 no-underline transition-colors hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
            aria-label={`Call Engage As You Age at ${PHONE_NUMBER}`}
          >
            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d={PHONE_ICON_PATH} />
            </svg>
            {PHONE_NUMBER}
          </a>
        </li>
      </ul>
    </nav>

    <!-- Mobile navigation -->
    <details id="mobile-menu" class="nav-dropdown group/menu relative lg:hidden">
      <summary
        class="relative z-10 flex cursor-pointer items-center justify-center rounded-md p-2 text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
        aria-label="Toggle main menu"
      >
        <svg class="h-6 w-6 group-open/menu:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
        </svg>
        <svg class="hidden h-6 w-6 group-open/menu:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </summary>
      <nav
        aria-label="Mobile navigation"
        class="fixed inset-x-0 top-0 z-0 flex h-dvh flex-col items-center overflow-y-auto bg-white px-6 pb-10 pt-28 dark:bg-gray-900"
      >
        <ul class="m-0 flex w-full max-w-xs flex-col items-center gap-2 list-none p-0 text-center">
          {NAV_LINKS.map((item) => (
            item.children ? (
              <li class="w-full">
                <details class="nav-dropdown group">
                  <summary
                    class:list={[
                      'flex cursor-pointer items-center justify-center rounded-md px-3 py-2',
                      linkClasses(isGroupActive(item), 'text-xl'),
                    ]}
                    aria-current={isGroupActive(item) ? 'page' : undefined}
                  >
                    <span class="relative inline-flex items-center justify-center">
                      {item.label}
                      <svg
                        class="absolute left-full ml-1 h-6 w-6 transition-transform group-open:rotate-180"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                          clip-rule="evenodd"
                        />
                      </svg>
                    </span>
                  </summary>
                  <ul class="m-0 flex list-none flex-col items-center gap-1 border-t border-gray-200 pt-2 dark:border-gray-700">
                    <li>
                      <a href={item.href} class:list={['block rounded-md px-3 py-2', linkClasses(isActive(item.href), 'text-lg')]} aria-current={isActive(item.href) ? 'page' : undefined}>
                        Overview
                      </a>
                    </li>
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class:list={['block rounded-md px-3 py-2', linkClasses(isActive(child.href), 'text-lg')]}
                          aria-current={isActive(child.href) ? 'page' : undefined}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li class="w-full">
                <a href={item.href} class:list={['block rounded-md px-3 py-2', linkClasses(isActive(item.href), 'text-xl')]} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            )
          ))}
          <li class="mt-3 w-full">
            <a href="/contact" class="btn-primary block text-center text-sm px-4 py-3">
              Contact
            </a>
          </li>
          <li class="w-full">
            <a
              href={PHONE_HREF}
              class="inline-flex w-full items-center justify-center gap-2 rounded-md px-3 py-2 text-xl font-medium text-gray-600 no-underline transition-colors hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
              aria-label={`Call Engage As You Age at ${PHONE_NUMBER}`}
            >
              <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={PHONE_ICON_PATH} />
              </svg>
              {PHONE_NUMBER}
            </a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  /* Hide the default <details>/<summary> disclosure triangle so the custom chevron icons stand alone. */
  .nav-dropdown > summary {
    list-style: none;
  }
  .nav-dropdown > summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  // Close open nav dropdowns when a click lands outside them, and when one opens, close its siblings.
  const dropdowns = Array.from(document.querySelectorAll<HTMLDetailsElement>('.nav-dropdown'));

  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    for (const dropdown of dropdowns) {
      if (dropdown.open && !dropdown.contains(target)) {
        dropdown.removeAttribute('open');
      }
    }
  });

  dropdowns.forEach((dropdown) => {
    dropdown.addEventListener('toggle', () => {
      if (!dropdown.open) return;
      for (const other of dropdowns) {
        if (other !== dropdown && other.open && !other.contains(dropdown)) {
          other.removeAttribute('open');
        }
      }
    });
  });

  // Lock background scrolling while the fullscreen mobile menu is open.
  const mobileMenu = document.querySelector<HTMLDetailsElement>('#mobile-menu');
  mobileMenu?.addEventListener('toggle', () => {
    document.body.classList.toggle('overflow-hidden', mobileMenu.open);
  });
</script>
